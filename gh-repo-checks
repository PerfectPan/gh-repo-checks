#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  gh repo-checks <command> [options]

Commands:
  pr-title TITLE          Check that a PR/MR title is an English Conventional Commit.
  pr-body [FILE|-]        Check a PR/MR description against the review template.
  repository [--staged]   Check required files, tracked artifacts, secrets,
                          private paths, and required review sections.
  protect [options]       Preview or apply GitHub branch protection.
  settings [options]      Audit GitHub settings without changing them.
  release-plan            Check that pending Changesets records can be consumed
                          and keep 0.x packages below 1.0.0.
  first-publish [MODE]    Check that the public packages to release exist on npm.

Run "gh repo-checks <command> --help" for command options.
USAGE
}

command="${1:-}"
case "$command" in
  settings)
    shift
    exec python3 "$root/checks/settings.py" "$@"
    ;;
  release-plan|first-publish)
    shift
    # The Changesets checks read the repository's installed @changesets/cli, so they run under Node.js.
    if ! command -v node >/dev/null 2>&1; then
      printf 'repo-checks %s: needs Node.js on PATH\n' "$command" >&2
      exit 1
    fi
    exec node "$root/checks/$command.mjs" "$@"
    ;;
  pr-title|pr-body|repository|protect)
    shift
    # Run the command under the interpreter that runs this dispatcher, so
    # "/bin/bash gh-repo-checks" exercises macOS bash 3.2 end to end.
    exec "$BASH" "$root/checks/$command.sh" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    printf 'repo-checks: unknown command: %s\n' "$command" >&2
    usage >&2
    exit 1
    ;;
esac
